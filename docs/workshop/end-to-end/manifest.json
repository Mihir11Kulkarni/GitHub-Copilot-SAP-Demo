{
  "_prompt": "Generate minimal Fiori manifest consuming Product OData service.",
  "sap.app": {
    "id": "workshop.product.app",
    "type": "application",
    "title": "Product Inventory",
    "dataSources": {
      "productSrv": {
        "uri": "/odata/v4/ProductService/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  }
}
